{
  // Static checking for the un-bundled frontend controllers. app.js and tools.js
  // are intentionally excluded: their remaining diagnostics are DOM event-target
  // narrowing noise that needs a deliberate pass, not a rule change.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "globals.d.ts",
    "cdn-modules.d.ts",
    "audit-runner.js",
    "admin.js",
    "admin-session.js",
    "assistant-ui.js",
    "competitor-ui.js",
    "custom-api.js",
    "evidence-map.js",
    "i18n.js",
    "monitoring.js",
    "report-export.js",
    "report-ui.js",
    "semantic-search.js",
    "site-pass.js"
  ]
}
